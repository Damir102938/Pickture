<?xml version="1.0" encoding="utf-8"?>
<!-- Сплэш: ножка P прорисовывается, затем контур play, затем заливка и мягкий «пружинящий» масштаб. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:name="mark"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0.7"
                android:scaleY="0.7">
                <path
                    android:name="stem"
                    android:pathData="M40,72L40,36"
                    android:strokeWidth="10"
                    android:strokeColor="#FFFFFFFF"
                    android:strokeLineCap="round"
                    android:trimPathEnd="0" />
                <path
                    android:name="play_fill"
                    android:pathData="M50.5,33.5L70.5,46L50.5,58.5Z"
                    android:fillColor="#FFFFFFFF"
                    android:fillAlpha="0" />
                <path
                    android:name="play_outline"
                    android:pathData="M50.5,33.5L70.5,46L50.5,58.5Z"
                    android:strokeWidth="6"
                    android:strokeColor="#FFFFFFFF"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:trimPathEnd="0" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="mark">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:duration="750"
                    android:valueFrom="0.7"
                    android:valueTo="1"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:duration="750"
                    android:valueFrom="0.7"
                    android:valueTo="1"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="stem">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:duration="300"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>

    <target android:name="play_outline">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:startOffset="220"
                android:duration="380"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>

    <target android:name="play_fill">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:startOffset="520"
                android:duration="250"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/linear" />
        </aapt:attr>
    </target>
</animated-vector>
