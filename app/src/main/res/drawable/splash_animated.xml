<?xml version="1.0" encoding="utf-8"?>
<!-- Сплэш: прорисовывается экран, из центра вырастает подставка, сердце появляется и дважды бьётся. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <path
                android:name="screen"
                android:pathData="M54,34H71A6,6 0,0 1,77 40V60A6,6 0,0 1,71 66H37A6,6 0,0 1,31 60V40A6,6 0,0 1,37 34H54"
                android:strokeWidth="4.5"
                android:strokeColor="#FFFFFFFF"
                android:strokeLineCap="round"
                android:trimPathEnd="0" />
            <path
                android:name="stand_left"
                android:pathData="M54,74H45"
                android:strokeWidth="4.5"
                android:strokeColor="#FFFFFFFF"
                android:strokeLineCap="round"
                android:trimPathEnd="0" />
            <path
                android:name="stand_right"
                android:pathData="M54,74H63"
                android:strokeWidth="4.5"
                android:strokeColor="#FFFFFFFF"
                android:strokeLineCap="round"
                android:trimPathEnd="0" />
            <group
                android:name="heart"
                android:pivotX="54"
                android:pivotY="50.5"
                android:scaleX="0"
                android:scaleY="0">
                <path
                    android:pathData="M54,58.9C44.4,51.7 43.2,45.7 48,43.3C51,42.1 53.4,43.9 54,46.3C54.6,43.9 57,42.1 60,43.3C64.8,45.7 63.6,51.7 54,58.9Z"
                    android:fillColor="#FFFFFFFF" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="screen">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:duration="420"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>

    <target android:name="stand_left">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:startOffset="250"
                android:duration="220"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>

    <target android:name="stand_right">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:startOffset="250"
                android:duration="220"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>

    <target android:name="heart">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <!-- Появление с пружинкой -->
                <set>
                    <objectAnimator
                        android:propertyName="scaleX"
                        android:startOffset="380"
                        android:duration="300"
                        android:valueFrom="0"
                        android:valueTo="1"
                        android:interpolator="@android:interpolator/overshoot" />
                    <objectAnimator
                        android:propertyName="scaleY"
                        android:startOffset="380"
                        android:duration="300"
                        android:valueFrom="0"
                        android:valueTo="1"
                        android:interpolator="@android:interpolator/overshoot" />
                </set>
                <!-- Два удара сердца -->
                <set>
                    <objectAnimator
                        android:propertyName="scaleX"
                        android:duration="140"
                        android:valueFrom="1"
                        android:valueTo="1.16"
                        android:repeatCount="3"
                        android:repeatMode="reverse"
                        android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <objectAnimator
                        android:propertyName="scaleY"
                        android:duration="140"
                        android:valueFrom="1"
                        android:valueTo="1.16"
                        android:repeatCount="3"
                        android:repeatMode="reverse"
                        android:interpolator="@android:interpolator/fast_out_slow_in" />
                </set>
            </set>
        </aapt:attr>
    </target>
</animated-vector>
